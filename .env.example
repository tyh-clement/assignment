# OpenRouter API key (used by chat and corpus ingestion)
OPENROUTER_API_KEY=

# Model used for both planning and answer generation (OpenRouter model id)
OPENROUTER_MODEL=openai/gpt-5-mini

# Embedding model and OpenRouter-compatible embeddings endpoint
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_API_BASE=https://openrouter.ai/api/v1

# Set to 1 for GitHub Actions/offline checks: local embeddings and deterministic mock LLM
# are used instead of OpenRouter.
# ORBITMESH_CI_MODE=1

# Optional overrides (defaults shown)
# CORPUS_DIR=corpus
# ORBITMESH_DATA_DIR=data
# CHROMA_DIR=data/chroma
# CHROMA_COLLECTION=orbitmesh_corpus
# INGEST_STATE_PATH=data/ingest_state.json
